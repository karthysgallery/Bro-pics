# Firebase (apps/web, functions)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Launch mode switches (REQUIRED in production; production fails closed if unset) ---
# Payment gateway: "mock" = simulated checkout, no money moves (orders show a TEST badge in admin);
# "razorpay" = real gateway (needs the three RAZORPAY_* values below).
PAYMENT_PROVIDER=mock
# Login OTP: "mock" = the code is shown on the sign-in screen (phone ownership is NOT verified, and
# OTP-only login is refused for staff/admin accounts); "production" = WhatsApp Cloud API.
WHATSAPP_OTP_MODE=mock
# Where OTP sessions live: "firestore" (default in production, shared across instances) or "memory" (dev).
OTP_STORE=
# Signs the karthys_session cookie. Required in production: a random string of 32+ characters.
SESSION_SECRET=

# Razorpay (only used when PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Algolia
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
NEXT_PUBLIC_ALGOLIA_SEARCH_ONLY_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=

# Storefront shell
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SITE_URL=
