{
  "name": "@bro-pics/print-render",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx src/server.ts",
    "bundle": "esbuild src/server.ts --bundle --platform=node --target=node20 --format=esm --outfile=lib/server.js --external:sharp --external:express --external:firebase-admin",
    "start": "node lib/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bro-pics/shared": "workspace:*",
    "express": "^4.21.0",
    "firebase-admin": "^12.6.0",
    "sharp": "^0.35.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.24.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
