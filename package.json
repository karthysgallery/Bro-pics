{
  "name": "bro-pics",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @bro-pics/web dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present --filter=\"!@bro-pics/firestore-rules-tests\" test",
    "test:rules": "pnpm --filter @bro-pics/firestore-rules-tests test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
